# ============================================================
# Database — PostgreSQL (required for Vercel; works locally too)
# ============================================================
# Local PostgreSQL:
#   DATABASE_URL="postgresql://postgres:password@localhost:5432/cf-coach"
#   DIRECT_DATABASE_URL="postgresql://postgres:password@localhost:5432/cf-coach"
#
# Neon serverless Postgres (recommended for Vercel):
#   DATABASE_URL="postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/cf-coach?sslmode=require"
#   DIRECT_DATABASE_URL="postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/cf-coach?sslmode=require"
#
# Vercel Postgres:
#   Use the connection strings from your Vercel dashboard.
#   Set DATABASE_URL to the pooled connection string.
#   Set DIRECT_DATABASE_URL to the non-pooled connection string.
DATABASE_URL="postgresql://postgres:password@localhost:5432/cf-coach"
DIRECT_DATABASE_URL="postgresql://postgres:password@localhost:5432/cf-coach"

# ============================================================
# NextAuth (generate with: openssl rand -base64 32)
# ============================================================
NEXTAUTH_SECRET="replace-with-a-random-secret"
# Local:  http://localhost:3000
# Vercel: https://your-project.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# ============================================================
# Google OAuth (https://console.cloud.google.com/apis/credentials)
# ============================================================
# Authorized redirect URIs:
#   Local:      http://localhost:3000/api/auth/callback/google
#   Production: https://YOUR_DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ============================================================
# GitHub OAuth (https://github.com/settings/developers)
# ============================================================
# Authorization callback URL:
#   Local:      http://localhost:3000/api/auth/callback/github
#   Production: https://YOUR_DOMAIN/api/auth/callback/github
GITHUB_ID=""
GITHUB_SECRET=""

# ============================================================
# Optional
# ============================================================
# AI Coach feature
OPENAI_API_KEY=""

# Codeforces signed API (not required for public sync)
CODEFORCES_API_KEY=""
CODEFORCES_API_SECRET=""
