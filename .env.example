# CF Coach — Environment Variables
# Copy this file to .env and fill in your values before running the app.

# ─── Database ───────────────────────────────────────────
# PostgreSQL connection string. For local dev use a local Postgres instance.
# For Vercel production, use a Neon pooled connection string
# (e.g. postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/cf-coach?pgbouncer=true)
DATABASE_URL="postgresql://postgres:password@localhost:5432/cf-coach"

# Direct (non-pooled) connection for Prisma CLI migrations.
# Only needed if you run `prisma migrate` locally; not required for `prisma db push`.
DIRECT_DATABASE_URL="postgresql://postgres:password@localhost:5432/cf-coach"

# ─── NextAuth ───────────────────────────────────────────
# Generate a random secret: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"

# Must match the actual origin where the app runs.
# Local:  http://localhost:3000
# Vercel: https://your-project.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# ─── Google OAuth ───────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI:  http://localhost:3000/api/auth/callback/google
#                           https://YOUR_DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── GitHub OAuth ───────────────────────────────────────
# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL:  http://localhost:3000/api/auth/callback/github
#                              https://YOUR_DOMAIN/api/auth/callback/github
GITHUB_ID=""
GITHUB_SECRET=""

# ─── OpenAI (Optional) ──────────────────────────────────
# Only needed for the AI Coach chat feature.
OPENAI_API_KEY=""

# ─── Codeforces API (Optional) ──────────────────────────
# Basic public sync does NOT require these — only a Codeforces handle.
# These are placeholder slots if you ever need authorized CF API calls.
CODEFORCES_API_KEY=""
CODEFORCES_API_SECRET=""
