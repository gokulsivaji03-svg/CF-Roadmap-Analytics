# Database
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_SECRET="change-this-to-a-random-secret-in-production"
# Keep this aligned with the actual local port you are using, e.g. 3000 or 3001.
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth
GITHUB_ID=""
GITHUB_SECRET=""

# OAuth callback URLs
# Local Google: http://localhost:3000/api/auth/callback/google
# Local GitHub: http://localhost:3000/api/auth/callback/github
# Production Google: https://YOUR_DOMAIN/api/auth/callback/google
# Production GitHub: https://YOUR_DOMAIN/api/auth/callback/github

# Optional
OPENAI_API_KEY=""

# Optional Codeforces signed-request support
CODEFORCES_API_KEY=""
CODEFORCES_API_SECRET=""
